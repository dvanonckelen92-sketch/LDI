---
import '../styles/global.css';
import { site, nav, socials } from '../data/site';

interface Crumb { name: string; href: string }
interface Props {
  title: string;          // zonder merksuffix
  description: string;
  image?: string;
  crumbs?: Crumb[];       // zonder "Home"
  schema?: object[];      // extra JSON-LD voor deze pagina
  brandFirst?: boolean;   // homepage: merk vooraan
  noindex?: boolean;      // bv. bedankpagina
  cta?: boolean;          // groene contactband onderaan
}

const { title, description, image = '/img/zonnepanelen-pannendak-2.jpg', crumbs = [], schema = [], brandFirst = false, noindex = false, cta = true } = Astro.props;
const fullTitle = brandFirst ? `${site.name}: ${title}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;

const business = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  '@id': `${site.url}/#bedrijf`,
  name: site.name,
  legalName: site.legalName,
  url: `${site.url}/`,
  logo: `${site.url}/img/logo.png`,
  image: `${site.url}/img/zonnepanelen-pannendak-2.jpg`,
  telephone: site.phoneIntl,
  email: site.email,
  vatID: site.vat,
  foundingDate: site.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.postalCode,
    addressLocality: `${site.locality} (${site.municipality})`,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  areaServed: { '@type': 'City', name: site.municipality },
  founder: { '@type': 'Person', name: site.owner, jobTitle: site.ownerRole },
  sameAs: socials.map((s) => s.url),
  ...(site.googleProfile ? { hasMap: site.googleProfile } : {}),
};

const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, site.url).href,
      })),
    }
  : null;

const jsonld = [business, ...(breadcrumb ? [breadcrumb] : []), ...schema];
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="theme-color" content="#12301f" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#inhoud">Naar de inhoud</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="LDI Solutions, naar de startpagina">
          <img src="/img/logo.png" alt="Logo LDI Solutions" width="400" height="313" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="hoofdmenu">Menu</button>
          <nav class="main-nav" id="hoofdmenu" aria-label="Hoofdmenu">
            <ul>
              {nav.map((n) => (
                <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
              ))}
              <li><a class="btn btn-small" href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact</a></li>
            </ul>
          </nav>
      </div>
    </header>

    {crumbs.length > 0 && (
      <nav class="crumbs wrap" aria-label="Kruimelpad">
        <a href="/">Home</a>
        {crumbs.map((c, i) => (
          <>
            <span aria-hidden="true">›</span>
            {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
          </>
        ))}
      </nav>
    )}

    <main id="inhoud">
      <slot />
    </main>

    {cta && (
      <section class="cta-band">
        <div class="wrap cta-inner">
          <div>
            <h2>Iets laten bekijken?</h2>
            <p>Lawrence komt zelf langs, kijkt naar uw groepenkast of dak en zegt eerlijk wat zinvol is.</p>
          </div>
          <div class="cta-actions">
            <a class="btn" href="/contact/#formulier">Stuur uw vraag</a>
            <a class="btn btn-outline-light" href={`tel:${site.phoneIntl}`}>Bel {site.phone}</a>
          </div>
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-title">{site.name}</p>
          <address>
            {site.street}<br />
            {site.postalCode} {site.locality} ({site.municipality})<br />
            <a href={`tel:${site.phoneIntl}`}>{site.phone}</a><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </address>
          <p class="small">Ondernemingsnummer {site.vat}</p>
        </div>
        <div>
          <p class="footer-title">Diensten</p>
          <ul class="plain">
            <li><a href="/elektriciteitswerken/">Elektriciteitswerken en domotica</a></li>
            <li><a href="/zonnepanelen/">Zonnepanelen plaatsen</a></li>
            <li><a href="/thuisbatterij/">Thuisbatterij installeren</a></li>
            <li><a href="/laadpaal/">Laadpaal thuis</a></li>
            <li><a href="/zelfbouw-met-begeleiding/">Zelfbouw met begeleiding</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-title">Meer</p>
          <ul class="plain">
            <li><a href="/realisaties/">Realisaties</a></li>
            <li><a href="/over-ons/">Over Lawrence en LDI Solutions</a></li>
            <li><a href="/contact/">Contact en route</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-title">Volg LDI Solutions</p>
          <ul class="plain">
            {site.googleProfile && <li><a href={site.googleProfile} rel="noopener" target="_blank">Google-bedrijfsprofiel en reviews</a></li>}
            {socials.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="wrap small footer-bottom">
        <span>© {new Date().getFullYear()} {site.legalName}</span>
        <a href="/privacy/">Privacyverklaring</a>
        <span class="credit">Website: <a href={site.credit.url} rel="nofollow noopener" target="_blank">{site.credit.name}</a></span>
      </div>
    </footer>

    <nav class="callbar" aria-label="Snel contact">
      <a href={`tel:${site.phoneIntl}`}>Bellen</a>
      <a href="/contact/#formulier">Vraag sturen</a>
    </nav>

    <dialog class="lightbox" aria-label="Foto vergroot">
      <button class="close" type="button" aria-label="Sluiten">×</button>
      <figure class="lb-fig"></figure>
      <p></p>
    </dialog>

    <script>
      // Menu
      const t = document.querySelector<HTMLButtonElement>('.menu-toggle');
      t?.addEventListener('click', () => {
        const open = t.getAttribute('aria-expanded') === 'true';
        t.setAttribute('aria-expanded', String(!open));
        document.body.classList.toggle('nav-open', !open);
      });

      // Schaduw op header + mobiele belbalk na wat scrollen
      const onScroll = () => document.body.classList.toggle('scrolled', window.scrollY > 240);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Elementen laten inglijden. Vangnet: in een verborgen tab, bij afdrukken of zonder
      // IntersectionObserver wordt alles meteen getoond, zodat er nooit inhoud verborgen blijft.
      const items = document.querySelectorAll('.reveal');
      const showAll = () => items.forEach((el) => el.classList.add('in'));
      addEventListener('beforeprint', showAll);
      if (document.visibilityState === 'hidden') showAll();
      else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      } else showAll();

      // Lightbox voor de galerij
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
      document.querySelectorAll<HTMLButtonElement>('.gallery button[data-full]').forEach((b) => {
        b.addEventListener('click', () => {
          if (!dlg) return;
          const fig = dlg.querySelector('.lb-fig')!;
          const img = fig.querySelector('img') || fig.appendChild(document.createElement('img'));
          img.src = b.dataset.full!;
          img.alt = b.dataset.alt || '';
          dlg.querySelector('p')!.textContent = b.dataset.alt || '';
          dlg.showModal();
        });
      });
      dlg?.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).closest('.close')) dlg.close(); });
    </script>
  </body>
</html>
